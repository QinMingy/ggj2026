# ==============================================
# Unity 核心忽略文件
# ==============================================
# Unity自动生成的项目配置（本地用户/编辑器设置，不共享）
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# Unity包管理器缓存
/Packages/packages-lock.json

# Unity云构建/CI相关
/[Aa]sset[Ss]tore[Pp]ackages/

# ==============================================
# 编辑器相关忽略
# ==============================================
# VSCode配置
.vscode/
*.code-workspace

# Visual Studio配置
.vs/
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Rider/IntelliJ配置
.idea/
*.sln.iml

# macOS系统文件
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows系统文件
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# ==============================================
# 构建产物与临时文件
# ==============================================
# 构建输出（自定义Build文件夹）
/Builds/
/build/
/ExportedProject/

# 临时缓存
*.tmp
*.bak
*.swp
*~
/Assembly-CSharp-firstpass.csproj
/Assembly-CSharp.csproj
/Assembly-CSharp-Editor.csproj
